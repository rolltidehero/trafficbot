NODE_ENV=production
LOG_LEVEL=info
# local: finite sequential batch; producer: enqueue and exit; worker/both: service
BOT_ROLE=both
REDIS_URL=redis://127.0.0.1:6379
REDIS_READY_TIMEOUT_MS=15000
# Only both may fall back at startup; never switch modes after a disconnect.
LOCAL_FALLBACK=false
SHUTDOWN_TIMEOUT_MS=30000
HEALTH_PORT=3000
# Use a target you control. Docker loopback refers to the container itself.
DEFAULT_URL=http://127.0.0.1:8080/
MAX_SESSIONS=1
# Any finite positive minutes, including fractions, or random (1–5 whole minutes).
SESSION_TIME=3
HEADLESS=true
HUMAN_BEHAVIOR=true
BEHAVIOR_INTENSITY=medium
ORGANIC_SEARCH=false
SEARCH_KEYWORDS=
SEARCH_ENGINE=google
SEARCH_TARGET_TYPE=url
SEARCH_TARGET_VALUE=
SEARCH_PAGES_LIMIT=1
REFERRER_POOL=
# Explicit opt-in host-network telemetry; skipped whenever a proxy is configured.
EXTERNAL_IP_CHECK=false
# Unsupported until measurements can be performed through the configured proxy.
MATCH_GEOLOCATION=false
PERSISTENT_SESSIONS=false
SESSIONS_DATA_DIR=./sessions
# Host or http://, https://, socks5:// host, WITHOUT port/path/credentials.
# Docker optional Tor: PROXY_URL=socks5://tor-proxy, PROXY_PORT=9050
PROXY_URL=
PROXY_PORT=
# Paired credentials supported for HTTP(S); SOCKS authentication is unsupported.
PROXY_USER=
PROXY_PASS=
